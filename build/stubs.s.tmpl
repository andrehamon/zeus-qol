# Export City Image (page 2 of the Display dialog)
.set EWIDGETS, BASE + (ewidgets - start)
.set EROWS,   BASE + (erows   - start)
.set EFW, @@EFW@@
.set EFH, @@EFH@@
.set EFX, @@EFX@@
.set ELABX, @@ELABX@@
.set EBARX, @@EBARX@@
.set EHINTY, @@EHINTY@@
.set ETITLE, @@ETITLE@@           # STRPTRS index of the page's title string (Save / Cancel / empty follow)
.set STR_EXPMENU, BASE + (str_expmenu - start)
.set STR_EFILE, BASE + (str_efile - start)
.set STR_EHINT, BASE + (str_ehint - start)
