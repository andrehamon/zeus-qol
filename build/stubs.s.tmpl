# keyboard controls (Options > Keyboard Controls)
.set KMAP,    BASE + (kmap    - start)      # physical VK -> VK the game sees (a permutation)
.set KINV,    BASE + (kinv    - start)
.set KTMPINV, BASE + (ktmpinv - start)
.set KCAP,    BASE + (kcap    - start)      # action row waiting for a key, -1 = none
.set KPAGE,   BASE + (kpage   - start)      # 1 = screen 0x0a shows the keyboard page instead of the display page
.set KWANT,   BASE + (kwant   - start)
.set DRAW_ROWS, BASE + (draw_rows - start)
.set DRAW_N,  BASE + (draw_n  - start)
.set DRAW_FH, BASE + (draw_fh - start)
.set DRAW_FW, BASE + (draw_fw - start)       # frame width (16 px blocks) and x offset of the page being drawn
.set DRAW_FX, BASE + (draw_fx - start)
.set DRAW_TITLE, BASE + (draw_title - start)
.set DRAW_TDX, BASE + (draw_tdx - start)       # title position offset (the long keyboard title is left-aligned: shift it to centre)
.set DRAW_TDY, BASE + (draw_tdy - start)
.set KBUF,    BASE + (kbuf    - start)
.set KNAME,   BASE + (kname   - start)
.set KCH,     BASE + (kch     - start)
.set KSCREENS, BASE + (kscreens - start)
.set ACTVK,   BASE + (actvk   - start)
.set ACTPTRS, BASE + (actptrs - start)
.set KNAMES,  BASE + (knames  - start)
.set KLBL,    BASE + (klbl    - start)
.set DWIDGETS, BASE + (dwidgets - start)
.set KWIDGETS, BASE + (kwidgets - start)
.set WIDGETS, BASE + (widgets - start)
