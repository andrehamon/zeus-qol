# Runtime resolution switcher for Zeus + Poseidon (see build_exe.py).
# Assembled with clang (AT&T syntax, i386) and placed in the new .wpat section.
# @@ placeholders are filled in by build_exe.py.

.set BASE, @@BASE@@
.set NUM, @@NUM@@
.set ENTSZ, @@ENTSZ@@
.set FILTER, @@FILTER@@        # 1 = F7 skips resolutions larger than the desktop

.macro CALLABS t
 .byte 0xE8
 .long \t - (BASE + (. - start) + 4)
.endm
.macro JEABS t
 .byte 0x0F, 0x84
 .long \t - (BASE + (. - start) + 4)
.endm
.macro JMPABS t
 .byte 0xE9
 .long \t - (BASE + (. - start) + 4)
.endm

.set CUR_R,   BASE + (cur_r   - start)
.set MODE_ARG, BASE + (mode_arg - start)
.set C_BUILD, @@C_BUILD@@          # C module entry points (cmod/mapcomp.c, linked behind the stubs)
.set C_LOAD,  @@C_LOAD@@
.set C_IMAGE, @@C_IMAGE@@
.set C_INTRO, @@C_INTRO@@
.set C_VBLIT, @@C_VBLIT@@
.set C_ZBUF, @@C_ZBUF@@          # city zoom (cmod/mapcomp.c cm_z*)
.set C_ZOOM, @@C_ZOOM@@
.set C_ZDIMS, @@C_ZDIMS@@
.set C_ZMIN, @@C_ZMIN@@
.set C_ZSHIFT, @@C_ZSHIFT@@
.set C_EXPORT, @@C_EXPORT@@         # city image export (cm_export)
.set LAST_R,  BASE + (last_r  - start)
.set LOADED,  BASE + (loaded  - start)
.set DSW,     BASE + (dsw     - start)
.set DSH,     BASE + (dsh     - start)
.set RESBUF,  BASE + (resbuf  - start)
.set RESNAME, BASE + (resname - start)
.set INTRO_PATH, BASE + (introname - start)
.set RANGES,  BASE + (ranges  - start)
.set ENTRIES, BASE + (entries - start)
.set DBG,     BASE + (dbg     - start)
.set DBGNAME, BASE + (dbgname - start)
.set RING,    BASE + (ring    - start)
.set RINGIDX, BASE + (ringidx - start)
.set BADMASK, BASE + (badmask - start)
.set SELECT_R, BASE + (select_r - start)
.set DLGROWS, BASE + (dlgrows - start)
.set STRPTRS, BASE + (strptrs - start)
.set NBTN, @@NBTN@@               # records of both click tables (the longer page)
.set NDLG, @@NDLG@@               # records of the Display page
.set NSTR, @@NSTR@@
.set FW, 0x16
.set FH, 0x14
.set LASTERR, BASE + (lasterr - start)
.set TITLEBUF, BASE + (titlebuf - start)
.set HEXTAB,  BASE + (hextab  - start)
.set STR_OK,  BASE + (str_ok  - start)
.set STR_TRY, BASE + (str_try - start)
