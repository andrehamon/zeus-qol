.text
start:
# ---------------------------------------------------------------- data
cur_r:   .long 0
mode_arg: .long 0         # mode ApplyMode was called for (the C map cache keys on it)
last_r:  .long 0
loaded:  .long 0
dsw:     .long 0
dsh:     .long 0
resbuf:  .space 64
resname: .asciz "Zeus.res"
dbgname: .asciz "Zeus.dbg"
introname: .asciz "Binks\\Zeus_Intro_HD.bik"       # same file cm_intro reads the header of
.balign 4
dbg:     .space 48
ring:    .space 8192
ringidx: .long 0
lasterr: .long 0
select_r: .long -1       # set by the Display-options buttons: entry to switch to (consumed by StubF7)
titlebuf: .space 128
hextab:  .ascii "0123456789ABCDEF"
str_ok:  .asciz "OK "
str_try: .asciz "TRY "
str_ref: .asciz "REFUSED "
str_r:   .asciz " R"
str_m:   .asciz " M"
str_err: .asciz " err=0x"
str_bad: .asciz " bad=0x"
.balign 4
badmask: .long 0       # bit n set = resolution n was refused by SetDisplayMode this session
f7cnt:   .long 0
goodcnt: .long 0
revcnt:  .long 0
fp:      .long 0, 0, 0, 0
scaled:  .long 0
rsdepth: .long 0
rstack:  .space 64
cityshadow: .space 800
zoomp:    .long 100
zapplied: .long 100
zvalid:   .long 0
zk:       .long 0x10000
zoc:      .long 0
zor:      .long 0
zargs:    .long 0, 0, 0, 0, 0, 0, 0, 0
zbuf:     .long 0
zvw:      .long 0
zvh:      .long 0
zsave:    .long 0, 0, 0, 0, 0, 0
zrawx:    .long 0
zvx:      .long 0
zvy:      .long 0
zrawy:    .long 0
zacc:     .long 0
ztick:    .long 0
ztemp:    .long 0
znslot:   .long -1
zntick:   .long 0
zncnt:    .long -1
zfmt:     .asciz "Zoom %d%%"
.balign 4
zdc:      .long 0
zdr:      .long 0
znewp:    .long 100
tlast:    .long 0, 0, 0, 0
zlevels:  .long 50, 60, 70, 80, 90, 100, 115, 130, 150, 175, 200
pathhdr: .space 2784
.balign 4
fittab:
@@FITTAB@@
.balign 4
ranges:
@@RANGES@@
entries:
@@ENTRIES@@
.balign 4
dlgrows:
@@DLGROWS@@
widgets:                         # ACTIVE click table of screen 0x0a (the game's 3 pushes point here); SetPage copies dwidgets / kwidgets over it
@@WIDGETS@@
dwidgets:
@@WIDGETS@@
kwidgets:
@@KWIDGETS@@
ewidgets:
@@EWIDGETS@@
strptrs:
@@STRPTRS@@
@@STRINGS@@
@@KDATA@@

# ---------------------------------------------------------------- code
.balign 16
# in: eax = mode.  Writes table[mode==3 ? cur_r : 0] into .text.  Clobbers eax ecx edx esi edi.
ApplyMode:
  movl %eax, MODE_ARG
  cmpl $3, %eax
  movl $0, %eax
  jne 1f
  movl CUR_R, %eax
1:
  imull $ENTSZ, %eax, %eax
  leal ENTRIES+24(%eax), %esi
  movl $RANGES+4, %edx
  pushl %ebx
  movl RANGES, %ebx
2:
  movl (%edx), %edi
  movl 4(%edx), %ecx
  addl $8, %edx
  rep movsb
  decl %ebx
  jnz 2b
  popl %ebx
  call InvalMap                   # also drop the cached world-map image (see below)
  pushl MODE_ARG                  # (re)build the world-map composites for the new resolution
  CALLABS C_BUILD
  addl $4, %esp
  ret

GetDesktop:
  pushl $0
  call *IMP_GETSYSTEMMETRICS
  movl %eax, DSW
  pushl $1
  call *IMP_GETSYSTEMMETRICS
  movl %eax, DSH
  ret

# in: eax = index.  out: eax = 1 if entry fits the desktop (entry 0 always fits)
Fits:
.if FILTER == 0
  movl BADMASK, %ecx
  btl %eax, %ecx
  jc 4f
  movl $1, %eax
  ret
4:
  xorl %eax, %eax
  ret
.endif
  testl %eax, %eax
  jz 3f
  imull $ENTSZ, %eax, %eax
  leal ENTRIES(%eax), %ecx
  movl (%ecx), %eax
  cmpl DSW, %eax
  ja 4f
  movl 4(%ecx), %eax
  cmpl DSH, %eax
  ja 4f
3:
  movl $1, %eax
  ret
4:
  xorl %eax, %eax
  ret

# Idempotent: read Zeus.res once, clamp to desktop.
EnsureLoaded:
  cmpl $0, LOADED
  jne 9f
  movl $1, LOADED
  call ResetKeys
  call LoadKeys
  call GetDesktop
  pushl $RESBUF
  pushl $RESNAME
  CALLABS 0x50ac60
  addl $8, %esp
  testl %eax, %eax
  jz 3f
  cmpl $0x31535a52, RESBUF      # "RZS1"
  jne 3f
  movl RESBUF+4, %eax
  cmpl $NUM, %eax
  jae 3f
  movl %eax, CUR_R
3:
  movl CUR_R, %eax
  testl %eax, %eax
  jz 5f
  call Fits
  testl %eax, %eax
  jnz 5f
  decl CUR_R
  jmp 3b
5:
  movl CUR_R, %eax
  movl %eax, LAST_R
9:
  ret

# ---- window-title readout:  <prefix> WxH R<idx> M<mode> [err=0x........] bad=0x........
# esi = dst; AppendStr: edx = src; AppendDec/AppendHex: eax = value.   All advance esi.
AppendStr:
1:
  movb (%edx), %al
  testb %al, %al
  jz 2f
  movb %al, (%esi)
  incl %esi
  incl %edx
  jmp 1b
2:
  ret

AppendDec:
  pushl %ebx
  movl $10, %ebx
  xorl %ecx, %ecx
1:
  xorl %edx, %edx
  divl %ebx
  pushl %edx
  incl %ecx
  testl %eax, %eax
  jnz 1b
2:
  popl %eax
  addb $0x30, %al
  movb %al, (%esi)
  incl %esi
  decl %ecx
  jnz 2b
  popl %ebx
  ret

AppendHex:
  movl $8, %ecx
1:
  roll $4, %eax
  movl %eax, %edx
  andl $15, %edx
  movb HEXTAB(%edx), %dl
  movb %dl, (%esi)
  incl %esi
  decl %ecx
  jnz 1b
  ret

# cdecl Title(char *prefix, int w, int h, int err).  Preserves all registers.
Title:
  pushal
  movl 0x24(%esp), %eax
  movl %eax, TLAST
  movl 0x28(%esp), %eax
  movl %eax, TLAST+4
  movl 0x2c(%esp), %eax
  movl %eax, TLAST+8
  movl 0x30(%esp), %eax
  movl %eax, TLAST+12
  movl $TITLEBUF, %esi
  movl 0x24(%esp), %edx
  call AppendStr
  movl 0x28(%esp), %eax
  call AppendDec
  movb $0x78, (%esi)
  incl %esi
  movl 0x2c(%esp), %eax
  call AppendDec
  movl $STR_R, %edx
  call AppendStr
  movl CUR_R, %eax
  call AppendDec
  movl $STR_M, %edx
  call AppendStr
  movl G_MODE, %eax
  call AppendDec
  movb $0x20, (%esi)
  incl %esi
  movb $0x5a, (%esi)
  incl %esi
  movl ZOOMP, %eax
  call AppendDec
  movl 0x30(%esp), %eax
  testl %eax, %eax
  jz 1f
  movl $STR_ERR, %edx
  call AppendStr
  movl 0x30(%esp), %eax
  call AppendHex
1:
  movl $STR_BAD, %edx
  call AppendStr
  movl BADMASK, %eax
  call AppendHex
  movb $0, (%esi)
  pushl $TITLEBUF
  pushl $0
  pushl $0x0C                      # WM_SETTEXT
  pushl G_HWND
  call *IMP_SENDMESSAGEA
  popal
  ret

# eax = event type, edx = arg.  Ring of 32 events x 8 dwords:
#  type, arg, cur_r, mode, game W, game H, windowed flag, sequence number
LogEv:
  pushl %ebx
  movl RINGIDX, %ebx
  andl $255, %ebx
  shll $5, %ebx
  addl $RING, %ebx
  movl %eax, (%ebx)
  movl %edx, 4(%ebx)
  movl CUR_R, %eax
  movl %eax, 8(%ebx)
  movl G_MODE, %eax
  movl %eax, 12(%ebx)
  movl 0xf2a6b4, %eax
  movl %eax, 16(%ebx)
  movl 0xf2a6b0, %eax
  movl %eax, 20(%ebx)
  movl 0xf2a764, %eax
  movl %eax, 24(%ebx)
  movl RINGIDX, %eax
  movl %eax, 28(%ebx)
  incl RINGIDX
  popl %ebx
  ret

# Diagnostic record (44 bytes, little-endian dwords) written to Zeus.dbg:
#  'DBG1', F7 presses, good displays, reverts, cur R, desktop W, desktop H, mode, last good R, game W, game H
WriteDbg:
  movl $0x31474244, DBG
  movl F7CNT, %eax
  movl %eax, DBG+4
  movl GOODCNT, %eax
  movl %eax, DBG+8
  movl REVCNT, %eax
  movl %eax, DBG+12
  movl CUR_R, %eax
  movl %eax, DBG+16
  movl DSW, %eax
  movl %eax, DBG+20
  movl DSH, %eax
  movl %eax, DBG+24
  movl G_MODE, %eax
  movl %eax, DBG+28
  movl LAST_R, %eax
  movl %eax, DBG+32
  movl 0xf2a6b4, %eax
  movl %eax, DBG+36
  movl 0xf2a6b0, %eax
  movl %eax, DBG+40
  movl RINGIDX, %eax
  movl %eax, DBG+44
  pushl $8240
  pushl $DBG
  pushl $DBGNAME
  CALLABS 0x50aef0
  addl $12, %esp
  ret

SaveR:
  movl $0x31535a52, RESBUF
  movl CUR_R, %eax
  movl %eax, RESBUF+4
  pushl $8
  pushl $RESBUF
  pushl $RESNAME
  CALLABS 0x50aef0
  addl $12, %esp
  ret

# --- hook: 0x5c3932  call 0x50b980 (display init, reads mode from G_MODE)
StubInit:
  pushal
  call EnsureLoaded
  movl G_MODE, %edx
  movl $5, %eax
  call LogEv
  movl G_MODE, %eax
  call ApplyMode
  call WriteDbg
  popal
  JMPABS 0x50b980

# --- hooks: 0x50bd29 / 0x50c05d  call 0x50bcc0(mode)   [stack: ret, mode]
StubSetMode:
  pushal
  call EnsureLoaded
  movl 0x24(%esp), %edx
  movl $4, %eax
  call LogEv
  movl 0x24(%esp), %eax
  call ApplyMode
  call WriteDbg
  popal
  JMPABS 0x50bcc0

StubRevert:
  pushal
  call EnsureLoaded
  movl LAST_R, %eax
  movl %eax, CUR_R
  movl $0, G_JPGCACHEMODE
  incl REVCNT
  movl 0x24(%esp), %edx
  movl $3, %eax
  call LogEv
  call WriteDbg
  movl 0x24(%esp), %eax
  call ApplyMode
  popal
  JMPABS 0x50bcc0

# --- hook: 0x50c0d3  mov [0xf9c140], ecx   (display mode confirmed good)
StubGood:
  movl %ecx, 0xf9c140
  pushal
  movl CUR_R, %eax
  movl %eax, LAST_R
  call SaveR
  incl GOODCNT
  movl 0x18(%esp), %edx            # saved ecx = mode that was confirmed
  movl $2, %eax
  call LogEv
  call WriteDbg
  pushl $0
  pushl 0xf2a6b0
  pushl 0xf2a6b4
  pushl $STR_OK
  call Title
  addl $16, %esp
  popal
  ret

# --- hook: 0x5c542d  F7 handler (was: push 3 / call ChangeMode)
StubF7:
  pushal
  call EnsureLoaded
  movl SELECT_R, %edi            # entry picked in the Display-options dialog, or -1
  movl $-1, SELECT_R
  movb G_UISTATE, %al
  cmpb $0x0f, %al
  je 8f
  cmpb $0x0e, %al
  je 8f
  cmpb $0x21, %al
  je 8f
  cmpb $0x05, %al
  je 8f
  testl %edi, %edi
  js 0f
  movl %edi, %ebx
  jmp 5f
0:
  cmpl $3, G_MODE
  jne 8f
  call GetDesktop
  pushl $0x10                    # VK_SHIFT -> previous resolution
  call *IMP_GETASYNCKEYSTATE
  movl $1, %edx
  testl $0x8000, %eax
  jz 1f
  movl $-1, %edx
1:
  movl CUR_R, %ebx
  movl $NUM, %esi
2:
  addl %edx, %ebx
  cmpl $NUM, %ebx
  jb 4f
  testl %ebx, %ebx
