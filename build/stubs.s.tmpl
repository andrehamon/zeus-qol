.set GOODCNT, BASE + (goodcnt - start)
.set REVCNT,  BASE + (revcnt  - start)

# world-map fit (see mapfit.py)
.set FITTAB,  BASE + (fittab  - start)
.set FP,      BASE + (fp      - start)      # +0 S16 +4 OX +8 OY +12 OFF
.set SCALED,  BASE + (scaled  - start)
